{
  "name": "tokioshy-portfolio",
  "version": "1.0.0",
  "private": true,
  "description": "Portfolio website of Me, Tokioshy, built with Tailwind CSS.",
  "scripts": {
    "build": "tailwindcss -i ./src/input.css -o ./public/assets/style.css --minify",
    "watch:css": "tailwindcss -i ./src/input.css -o ./public/assets/style.css --watch",
    "serve": "serve public -l 3000",
    "dev": "concurrently -k \"npm:watch:css\" \"npm:serve\""
  },
  "devDependencies": {
    "concurrently": "^9.0.0",
    "serve": "^14.2.0",
    "tailwindcss": "3.4.17"
  }
}
